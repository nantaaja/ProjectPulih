<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardJournalItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/pure_white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_soft"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Mood Badge Container -->
        <LinearLayout
            android:id="@+id/layoutMoodBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_tenang"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvMoodEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                tools:text="😊" />

            <TextView
                android:id="@+id/tvMoodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/font_jakarta_sans"
                android:textColor="@color/forest_sage_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Tenang" />
        </LinearLayout>

        <!-- Tanggal & Jam Entri Jurnal -->
        <TextView
            android:id="@+id/tvJournalDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/font_jakarta_sans"
            android:textColor="@color/dark_slate_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/layoutMoodBadge"
            app:layout_constraintEnd_toStartOf="@+id/btnJournalOptions"
            app:layout_constraintStart_toEndOf="@+id/layoutMoodBadge"
            app:layout_constraintTop_toTopOf="@+id/layoutMoodBadge"
            tools:text="Hari ini, 08:30" />

        <!-- Tombol Menu 3 Titik Opsi -->
        <ImageView
            android:id="@+id/btnJournalOptions"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Opsi Jurnal"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="@+id/layoutMoodBadge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layoutMoodBadge" />

        <!-- Isi Catatan Jurnal -->
        <TextView
            android:id="@+id/tvJournalContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/font_jakarta_sans"
            android:lineSpacingExtra="3dp"
            android:maxLines="3"
            android:textColor="@color/dark_slate"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutMoodBadge"
            tools:text="Pagi yang sejuk. Berhasil menyelesaikan review materi tanpa panik, dan menyempatkan jalan pagi keliling kompleks..." />

        <!-- Tag Kategori & Arrow -->
        <LinearLayout
            android:id="@+id/layoutTags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivChevron"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvJournalContent">

            <TextView
                android:id="@+id/tvTag1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_chip"
                android:fontFamily="@font/font_jakarta_sans"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/dark_slate_secondary"
                android:textSize="11sp"
                tools:text="Kuliah" />

            <TextView
                android:id="@+id/tvTag2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tag_chip"
                android:fontFamily="@font/font_jakarta_sans"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/dark_slate_secondary"
                android:textSize="11sp"
                tools:text="Istirahat" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Detail Jurnal"
            android:src="@drawable/ic_chevron_right"
            app:layout_constraintBottom_toBottomOf="@+id/layoutTags"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layoutTags" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
