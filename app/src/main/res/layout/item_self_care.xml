<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_task_item"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- Icon Status (Checked / Unchecked) -->
    <ImageView
        android:id="@+id/ivCheckStatus"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Status Target"
        android:src="@drawable/ic_check_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Judul Target Self Care (ID diawali txt) -->
    <TextView
        android:id="@+id/txtTaskTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/font_jakarta_sans"
        android:textColor="@color/dark_slate"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/txtTaskTime"
        app:layout_constraintStart_toEndOf="@+id/ivCheckStatus"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Istirahat dari sosmed 30 menit" />

    <!-- Waktu Target Self Care (ID diawali txt) -->
    <TextView
        android:id="@+id/txtTaskTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_badge_white"
        android:fontFamily="@font/font_jakarta_sans"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="@color/dark_slate_secondary"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="12:30" />

</androidx.constraintlayout.widget.ConstraintLayout>
