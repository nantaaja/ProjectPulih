<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ProjectPulih" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/forest_sage</item>
        <item name="colorOnPrimary">@color/pure_white</item>
        <item name="colorPrimaryContainer">@color/forest_sage_light</item>
        <item name="colorOnPrimaryContainer">@color/forest_sage_dark</item>

        <item name="colorSecondary">@color/terracotta_peach</item>
        <item name="colorOnSecondary">@color/pure_white</item>

        <item name="android:colorBackground">@color/warm_sand</item>
        <item name="colorSurface">@color/pure_white</item>
        <item name="colorOnSurface">@color/dark_slate</item>

        <item name="android:textColorPrimary">@color/dark_slate</item>
        <item name="android:textColorSecondary">@color/dark_slate_secondary</item>

        <!-- Typography / Font -->
        <item name="fontFamily">@font/font_jakarta_sans</item>
        <item name="android:fontFamily">@font/font_jakarta_sans</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/warm_sand</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/warm_sand</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.ProjectPulih" parent="Base.Theme.ProjectPulih" />

    <!-- Style for rounded pill buttons -->
    <style name="Widget.Pulih.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/forest_sage</item>
        <item name="android:textColor">@color/pure_white</item>
        <item name="android:fontFamily">@font/font_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.Pulih.Button.Terracotta" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/terracotta_peach_dark</item>
        <item name="android:textColor">@color/pure_white</item>
        <item name="android:fontFamily">@font/font_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="Widget.Pulih.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/warm_sand</item>
        <item name="strokeColor">@color/border_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/dark_slate</item>
        <item name="android:fontFamily">@font/font_jakarta_sans</item>
        <item name="cornerRadius">24dp</item>
    </style>
</resources>